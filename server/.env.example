NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/vjedulink
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173

# Optional: configure Google Drive uploads with JSON secrets in Render.
# Local development can continue using the *_FILE variables instead.
GOOGLE_OAUTH_CREDENTIALS_FILE=./config/google-oauth-credentials.json
GOOGLE_OAUTH_TOKEN_FILE=./tokens/google-token.json
GOOGLE_OAUTH_CREDENTIALS_JSON=
GOOGLE_OAUTH_TOKEN_JSON=
GOOGLE_OAUTH_REDIRECT_URI=

# Optional Google Drive folder IDs (set these in Render to enable uploads).
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_EVENTS_FOLDER_ID=
GOOGLE_DRIVE_TANDP_FOLDER_ID=
GOOGLE_DRIVE_COURSES_FOLDER_ID=
GOOGLE_DRIVE_TIMETABLE_FOLDER_ID=
GOOGLE_DRIVE_ANNOUNCEMENTS_FOLDER_ID=
GOOGLE_DRIVE_RESOURCES_FOLDER_ID=
GOOGLE_DRIVE_PROFILES_FOLDER_ID=
GOOGLE_DRIVE_SCHOLARSHIP_FOLDER_ID=

# Set these only when running npm run admin:create.
ADMIN_COLLEGE_ID=
ADMIN_NAME=
ADMIN_PHONE=
ADMIN_PASSWORD=
